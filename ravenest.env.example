# Ravenest runtime configuration (PostgreSQL + auth + chat translation).

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# One cluster, four logical databases. There are no cross-database joins.
RAVENEST_GAME_DB_URL=postgresql://ravenest:change-me@127.0.0.1:5432/ravenest_game
RAVENEST_CHAT_DB_URL=postgresql://ravenest:change-me@127.0.0.1:5432/ravenest_chat
RAVENEST_STAFF_DB_URL=postgresql://ravenest:change-me@127.0.0.1:5432/ravenest_staff
RAVENEST_INVITES_DB_URL=postgresql://ravenest:change-me@127.0.0.1:5432/ravenest_invites

# ── HTTP / auth ─────────────────────────────────────────────────────────────
# Browser origins allowed to call the API with credentials.
RAVENEST_CORS_ORIGINS=https://app.example.com
# Set to 0 only for local HTTP development; production refresh cookies are Secure.
RAVENEST_COOKIE_SECURE=1
# Refresh tokens are cookie-scoped to /api/auth and host-only on the API host.

# ── Chat translation (CPU MADLAD baseline) ──────────────────────────────────
RAVENEST_TRANSLATION_SIDECAR_URL=http://127.0.0.1:8790

# ── Avatars ─────────────────────────────────────────────────────────────────
# local = age-gated /api/avatar/<id>; r2 = public capability URLs.
RAVENEST_AVATAR_STORAGE=local
RAVENEST_AVATAR_LOCAL_ROOT=uploads/avatars
# Required when RAVENEST_AVATAR_STORAGE=r2:
# RAVENEST_R2_ACCOUNT_ID=
# RAVENEST_R2_ACCESS_KEY_ID=
# RAVENEST_R2_SECRET_ACCESS_KEY=
# RAVENEST_R2_BUCKET=
# RAVENEST_R2_PUBLIC_BASE_URL=

# ── Push ────────────────────────────────────────────────────────────────────
# VAPID keys live in game/config/push.json.
