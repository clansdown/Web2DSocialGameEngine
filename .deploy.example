# .deploy.example — template for the private deployment configuration.
#
# Copy this file to .deploy, fill in the values for your deployment, then:
#
#     chmod 600 .deploy
#
# .deploy is gitignored and must never be committed. The values are sourced as
# a shell fragment by install.sh, so keep it to simple assignments. See
# docs/publishing.md for the full setup and verification procedure.
#
# Publishing the server image is a separate developer workflow controlled by
# .publish_engine and publish_engine_server_image.sh. Deployers do not need
# registry credentials.

# --- Pages site repo ---------------------------------------------------------
# Private repository whose root is the generated Pages site (index.html at the
# root). install.sh rsyncs client/dist here and then commits and pushes.
# SITE_REPO="$HOME/src/example-site"

# Private directory copied into the site repo after the build sync. It holds
# _headers, robots.txt, favicon, and any _redirects file. Leave empty to skip.
# SITE_OVERLAY="$HOME/src/example-ops/pages-overlay"

# --- R2 public assets (S3 API) ----------------------------------------------
# Private bucket. Public access is through the assets.app.example.com custom domain.
R2_BUCKET=""

# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""

# R2 API token with Object Read & Write on the bucket.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# --- Public origins baked into the client build ------------------------------
# Origins only: scheme + host, no trailing slash and no path. PUBLIC_API_ORIGIN
# and PUBLIC_ASSETS_ORIGIN are required whenever the Pages client is built.
PUBLIC_SITE_ORIGIN="https://app.example.com"
PUBLIC_API_ORIGIN="https://api.example.com"
PUBLIC_ASSETS_ORIGIN="https://assets.example.com"
PUBLIC_WS_ORIGIN="wss://api.example.com"

# --- API server content mirror + runtime env --------------------------------
# The build host must reach the API server over SSH/LAN. The Cloudflare Tunnel
# is outbound only and does not provide an inbound rsync path.
SERVER_HOST=""
SERVER_PATH=""

# "docker" (default: pull the prebuilt server image, write compose files,
# restart compose) or "systemd" (write the env file and run SERVER_RESTART_CMD).
SERVER_DEPLOY_MODE="docker"

# PostgreSQL topology:
#   bundled  (default) - Docker Compose runs PostgreSQL with the server.
#   external           - use the four SERVER_*_DB_URL values below.
# bundled requires SERVER_DEPLOY_MODE=docker. For a host/systemd app with a
# container or managed database, use external.
SERVER_DB_MODE="bundled"
SERVER_DB_USER="ravenest"
# Required when SERVER_DB_MODE=bundled. Use URL-safe characters only, e.g.
#   openssl rand -hex 24
# The raw password is used by PostgreSQL and embedded in the generated URLs.
SERVER_DB_PASSWORD=""
# Defaults are relative to SERVER_PATH.
SERVER_DB_INIT_PATH=""
SERVER_COMPOSE_OVERLAY_PATH=""

# External/managed PostgreSQL only (SERVER_DB_MODE=external). The four URLs are
# written to SERVER_ENV_PATH; the server fails closed if any is missing.
# Percent-encode special characters in the password. With a Docker app, do not
# point these at 127.0.0.1: inside the bridge network that is the app container.
# Example:
#   postgresql://ravenest:change-me@db.example.net:5432/ravenest_game?sslmode=require
SERVER_GAME_DB_URL=""
SERVER_CHAT_DB_URL=""
SERVER_STAFF_DB_URL=""
SERVER_INVITES_DB_URL=""

# --- Docker server image (SERVER_DEPLOY_MODE=docker) -----------------------
# Prebuilt image to deploy. install.sh never builds or pushes it; developers
# publish it separately with ./publish_engine_server_image.sh. A deployer only
# needs these two image values and no registry credentials.
#
# The official public image is:
SERVER_IMAGE="ghcr.io/clansdown/web2dsocialgameengine"
# Use latest for convenience, or pin the immutable tag printed by the publish
# script for reproducible production deployments. install.sh never derives this
# value: it must name an image that already exists in the registry.
SERVER_IMAGE_TAG="latest"
# Optional remote pull command. Defaults to:
#   docker pull 'SERVER_IMAGE:SERVER_IMAGE_TAG'
# Override when the remote Docker command needs sudo or another wrapper.
SERVER_PULL_CMD=""
# Defaults are relative to SERVER_PATH.
SERVER_COMPOSE_PATH=""
SERVER_COMPOSE_ENV_PATH=""
SERVER_UPLOADS_PATH=""
# Optional owner for the uploads bind mount (the image runs as 10001:10001).
# install.sh tries a direct chown, then a Docker root-helper container; if both
# fail, chown the directory manually.
SERVER_UPLOADS_OWNER=""
# Set to 1 to silence the loopback-DB-URL warning in Docker mode.
SERVER_ALLOW_LOOPBACK_DB_URL="0"

# Optional private key for the content mirror and env write. Use $HOME, not ~
# (the value is used as a literal path).
SERVER_SSH_KEY=""

# Browser origins allowed by the API's CORS layer. Comma-separated. Defaults
# to PUBLIC_SITE_ORIGIN when empty. install.sh writes the value to
# SERVER_ENV_PATH as RAVENEST_CORS_ORIGINS.
SERVER_CORS_ORIGINS=""

# --- Custom avatar storage ---------------------------------------------------
# "local" (development/default) or "r2" (production). R2 uses the same bucket
# as public assets, under AVATAR_R2_PREFIX, with a separate scoped token.
SERVER_AVATAR_STORAGE="local"
AVATAR_R2_ACCESS_KEY_ID=""
AVATAR_R2_SECRET_ACCESS_KEY=""
AVATAR_R2_PREFIX="avatars/"
# Public origin serving the bucket; defaults to PUBLIC_ASSETS_ORIGIN.
AVATAR_PUBLIC_BASE_URL=""
# Optional cache-purge credentials. Without them, removal still deletes the R2
# object but cannot purge an already-cached edge URL.
AVATAR_CLOUDFLARE_ZONE_ID=""
AVATAR_CLOUDFLARE_API_TOKEN=""

# Defaults to ${SERVER_PATH}/ravenest.env. The service must read this file
# (systemd EnvironmentFile or Docker env_file). Keep it outside game/.
SERVER_ENV_PATH=""

# Optional. Run after the env file changes; if empty, install.sh writes the
# file and prints a reminder to restart the API server manually.
# SERVER_RESTART_CMD="sudo systemctl restart ravenest"

# --- Cloudflare API (reserved for purge-on-deploy) --------------------------
# CF_ZONE_ID is also the default AVATAR_CLOUDFLARE_ZONE_ID. Avatar purges use a
# separate Cache Purge-only token (AVATAR_CLOUDFLARE_API_TOKEN).
CF_API_TOKEN=""
CF_ZONE_ID=""
