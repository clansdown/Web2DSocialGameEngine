# client/.env.example — local development origins.
#
# Copy to client/.env.development.local (gitignored). Leave the values empty to
# use the Vite dev proxy, which forwards /api, /images, and /ws to
# http://localhost:2290. Set absolute origins to talk to a remote API/assets
# host directly; the API must allow http://localhost:8120 through CORS in that
# case.
#
# Production builds do not read this file. install.sh exports the production
# values from .deploy before running `npm run build`.

VITE_API_BASE_URL=
VITE_ASSETS_BASE_URL=
VITE_WS_BASE_URL=

# Optional: change the dev proxy target (default http://localhost:2290).
DEV_PROXY_TARGET=http://localhost:2290
